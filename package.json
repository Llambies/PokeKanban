{
  "name": "pokekanban",
  "private": true,
  "version": "1.0.0",
  "description": "Tablero Kanban personal estilo Trello, sin límites y sin colaboración.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "check": "tsc -b && vitest run",
    "build:static": "tsc -b && vite build --mode static",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "dev:worker": "npm run build && wrangler dev"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@hello-pangea/dnd": "^18.0.1",
    "dompurify": "^3.4.16",
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
