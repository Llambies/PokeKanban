// Cloudflare Worker with cloud storage (Durable Object) and login.
//   Build: npm run build      Deploy: npx wrangler deploy
// Set the POKEKANBAN_PASSWORD secret before using it (dashboard → Worker → Settings →
// Variables and Secrets, or `npx wrangler secret put POKEKANBAN_PASSWORD`).
{
  "name": "pokekanban",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Custom domain (the llambies.com zone lives in the same Cloudflare account).
  "routes": [{ "pattern": "kanban.llambies.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "PokeKanbanStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokeKanbanStore"] }],
  "observability": { "enabled": true }
}
