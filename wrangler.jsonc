// Cloudflare Workers (static assets). Build first with `npm run build:static`,
// then `npx wrangler deploy` (or connect the repo in the Cloudflare dashboard).
{
  "name": "pokekanban",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
